ANTHROPIC_API_KEY=
TAVILY_API_KEY=
# Optional search router (https://docs.telem.ai): with a Telem key (tlm_...) set, Echo's searches go through Telem's
# auto-routing (Exa, Tavily, Brave, Parallel, Perplexity) and page reading stays on Tavily. Telem bills each provider
# that answers from prepaid credit; Echo reserves $0.031 per search on Telem's daily cap below. Leave empty for Tavily.
TELEM_API_KEY=
# tavily forces Tavily search even with a Telem key (e.g. when Telem's credit runs out); telem requires the key.
# ECHO_SEARCH_ROUTER=tavily
# Lower-cost option: claude-haiku-5-5. Compare source judgments before switching.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional split: Haiku groups/judges pages; Sonnet writes the final answer.
# ANTHROPIC_CLASSIFIER_MODEL=claude-haiku-5-5
# ANTHROPIC_ANSWER_MODEL=claude-sonnet-5-5
# Daily spending caps, one per provider (Pacific day; since 11/13 they replace the single ECHO_ANTHROPIC_DAILY_CAP_USD,
# which is no longer read). Claude's is a runaway ceiling (held to at most $200); Tavily's covers searches and page
# reading (at most $50); Telem's covers its routed searches (at most $20). When Telem's cap is reached a run searches
# with Tavily instead of failing.
ECHO_CLAUDE_DAILY_CAP_USD=50
ECHO_TAVILY_DAILY_CAP_USD=5
ECHO_TELEM_DAILY_CAP_USD=3
# Telem's prepaid credit: the budget line shows Telem's running total (every day) against it. Advisory, never a block.
ECHO_TELEM_CREDIT_USD=20
# Optional shared budget ledger for Vercel deployments (Upstash Redis).
# Configure both values together; leave both unset for the local file ledger.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Price per Tavily credit, counted against Tavily's daily cap (0 disables Tavily tracking).
ECHO_TAVILY_USD_PER_CREDIT=0.008

# Copy hunt (beta, off by default). 1 = show the "Hunt for more copies" button: up to 3 basic Tavily searches,
# no Claude, counted in Tavily's daily cap. Results are listed as possible copies and never change a trace's counts.
ECHO_COPY_HUNT=0
# Source judge: pages that only retell a source Echo did not retrieve are not counted as origins. Set 0 to turn off.
ECHO_RETELLING_CHECK=1
# Source links: read each retrieved page's own HTML links (free, direct fetch, 7 s step limit) so a source list that
# search text dropped still counts as a citation. Set 0 to turn off.
ECHO_HTML_LINKS=1
# Link previews: the public address shared links unfurl from (e.g. https://echo.example). Not needed on Vercel,
# where Next reads its own deployment URL. Leave empty locally.
ECHO_SITE_URL=
# Presenter lock for a public deployment: with a key set, only a browser that opened /api/presenter?key=<key>
# once can start live runs or copy hunts; visitors can still open demo slots and saved traces. Leave empty locally.
ECHO_PRESENTER_KEY=
# Browser extension side panel (extension/): the extension origins allowed to frame /embed and start its one run from
# the selection pop-up (comma-separated chrome-extension://<32-letter id> only; anything else is ignored). The repo's
# extension has a fixed id, so this line enables it. Empty = /embed cannot be framed; right-click menus still work.
# ECHO_EXTENSION_ORIGINS=chrome-extension://binkgignaekgeoklkoplgpddepbefabb

# Cost switches (all off by default except the search cache; each needs a live A/B before it becomes a default; see
# npm run measure:cost).
# Advanced search pass: runs when basic searches found fewer than N pages (default 20; 0 skips it; above 20 acts
# as 20). It costs 6 credits (~$0.05) and on 5 saved runs added 0-3 kept pages, none of them an origin.
# ECHO_DEEP_SEARCH_BELOW=10
# Prompt cache for the source-judgment request: 1 = same text, billed 1.25x on a first send and ~0.05x on a repeat
# within 5 minutes. Use it for rejudge:trace loops (~44% cheaper) and back-to-back live runs; a lone run pays ~$0.004 more.
# ECHO_PROMPT_CACHE=1
# Search cache (ON by default since 11/13): a run that is not "Run fresh" reuses this server's completed searches from
# the last 15 minutes (as extracts already are), so retrying a failed or uncached run does not pay 5-16 credits again.
# "Run fresh" always searches. 0 turns the cache off.
# ECHO_SEARCH_CACHE=0
# Grouping model: run only the page-grouping request on a cheaper model (claude-haiku-5-5, ~1/20 the price, ~$0.009 a
# run saved); the source judgment stays on the classifier model. Grouping decides which pages are compared: A/B first.
# ANTHROPIC_GROUPING_MODEL=claude-haiku-5-5
# Thinking: Echo sends no thinking setting, so Sonnet 5.5 and Haiku 5.5 think by default and bill it as output. A
# comma list of steps (grouping, judgment, answer, or all) turns it off for them (Sonnet: between_tools; Haiku:
# disabled). It may change judgments: A/B with rejudge:trace first. ECHO_LOG_USAGE=1 prints each request's
# thinking tokens to stderr.
# ECHO_THINKING_OFF=judgment
# ECHO_LOG_USAGE=1
# Search page text: 1 asks each search for its results' page text (include_raw_content) and skips the extract for
# pages that came with it (~2-3 extract credits, ~$0.02 a run). Tavily prices searches by depth only; a live receipt
# must confirm searches still bill 1 credit. The judged text changes (whole page, not two extract chunks): A/B first.
# ECHO_SEARCH_RAW_CONTENT=1

# Origin layer (README "Origin layer"). ECHO_ORIGIN_LAYER=1 lets POST /api/compare spend two Claude answer calls per
# comparison (a few cents, through the Claude cap). NEXT_PUBLIC_ECHO_ORIGIN_LAYER=1 shows the layer by default (it is
# otherwise switched on per browser with Shift+O). The MCP server reads ECHO_MCP_LIVE=1 and ECHO_URL from its own
# environment, not from this file.
# ECHO_ORIGIN_LAYER=1
# NEXT_PUBLIC_ECHO_ORIGIN_LAYER=1
